<Window x:Class="TabletDroid.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TabletDroid" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#121214" Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- 버튼 및 카드 스타일 -->
        <Style x:Key="AppCardStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2E2E38"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A34"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#18181E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단 헤더 & 런타임 상태 바 -->
        <Grid Grid.Row="0" Margin="0,0,0,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <TextBlock Text="TabletDroid" FontSize="32" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Windows Tablet Android Runtime" FontSize="14" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="StatusBadge" Background="#334155" CornerRadius="12" Padding="12,6" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="STOPPED" FontWeight="SemiBold" FontSize="12" Foreground="#E2E8F0"/>
                    </StackPanel>
                </Border>

                <Button x:Name="BtnToggleEmbed" Content="Embed Window" Background="#334155" Style="{StaticResource PrimaryActionBtn}" Click="OnToggleEmbedClicked" Margin="0,0,8,0"/>
                <Button x:Name="BtnStartRuntime" Content="Start Runtime" Style="{StaticResource PrimaryActionBtn}" Click="OnStartRuntimeClicked" Margin="0,0,8,0"/>
                <Button x:Name="BtnStopRuntime" Content="Stop" Background="#334155" Style="{StaticResource PrimaryActionBtn}" Click="OnStopRuntimeClicked"/>
            </StackPanel>
        </Grid>

        <!-- 중앙 영역: 앱 선택 화면 또는 임베디드 에뮬레이터 뷰포트 -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="AppGridScrollViewer" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Pinned Applications" FontSize="18" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="12,0,0,16"/>

                    <WrapPanel Orientation="Horizontal">
                        <!-- Instagram Card -->
                        <Button Width="220" Height="200" Style="{StaticResource AppCardStyle}" Click="OnLaunchInstagramClicked">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="16" Background="#E1306C" Margin="0,0,0,16">
                                    <TextBlock Text="📷" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Instagram" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Portrait / Fullscreen" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- YouTube Card -->
                        <Button Width="220" Height="200" Style="{StaticResource AppCardStyle}" Click="OnLaunchYouTubeClicked">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="16" Background="#FF0000" Margin="0,0,0,16">
                                    <TextBlock Text="▶" FontSize="32" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="YouTube" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Landscape Tablet" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Discord Card -->
                        <Button Width="220" Height="200" Style="{StaticResource AppCardStyle}" Click="OnLaunchDiscordClicked">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="16" Background="#5865F2" Margin="0,0,0,16">
                                    <TextBlock Text="💬" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Discord" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Adaptive UI" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Embedded Emulator Viewport Container -->
            <Border x:Name="EmulatorViewport"
                    Background="#000000"
                    CornerRadius="12"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    SizeChanged="OnEmulatorViewportSizeChanged"/>
        </Grid>

        <!-- 하단 정보 및 로그 -->
        <Border Grid.Row="2" Background="#18181B" CornerRadius="12" Padding="16,12" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LogText" Text="Ready to start TabletDroid Runtime." Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="v0.1 MVP - ASUS ROG Flow Z13 Target" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
