<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tabletdroid.benchmark"
    android:versionCode="1"
    android:versionName="1.0.0">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <application
        android:label="TabletDroid Benchmark"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:hardwareAccelerated="true">

        <activity
            android:name=".BenchmarkActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".InputProbeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density">
            <intent-filter>
                <action android:name="com.tabletdroid.benchmark.ACTION_INPUT_PROBE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BenchmarkReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tabletdroid.benchmark.ACTION_START" />
                <action android:name="com.tabletdroid.benchmark.ACTION_STOP" />
                <action android:name="com.tabletdroid.benchmark.ACTION_RESET" />
                <action android:name="com.tabletdroid.benchmark.ACTION_GET_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
